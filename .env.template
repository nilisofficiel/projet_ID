# API Keys for Animated Reality Show Project
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to Git!

# Hugging Face API Key (for Toonify avatar creation)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# D-ID API Key (for avatar animation)
# Get your key at: https://studio.d-id.com/account-settings
DID_API_KEY=your_did_api_key_here

# DeepMotion API Key (optional, for body animations)
# Get your key at: https://www.deepmotion.com/
DEEPMOTION_API_KEY=your_deepmotion_api_key_here

# Runway ML API Key (optional, for scene composition)
# Get your key at: https://runwayml.com/
RUNWAYML_API_KEY=your_runwayml_api_key_here
